class UtilesEscolares:

    def __init__(self):
        self.productos = {}

    def agregar_producto(self, nombre, precio):
        self.productos[nombre] = precio

    def calcular_total(self):
        total = 0

        for precio in self.productos.values():
            total = total + precio

        return total

    def productos_por_rango(self, minimo, maximo):
        resultado = []

        for nombre, precio in self.productos.items():
            if precio >= minimo and precio <= maximo:
                resultado.append(nombre)

        return resultado


u = UtilesEscolares()

u.agregar_producto("Cuaderno", 2.50)
u.agregar_producto("Mochila", 25)
u.agregar_producto("Lapiz", 0.50)
u.agregar_producto("Carpeta", 3)

print(u.calcular_total())
print(u.productos_por_rango(1, 5))