class AnalizadorCaracteres:

    def __init__(self):
        self.texto_mayor = ""

    def es_vocal(self, letra):
        if letra.lower() in "aeiou":
            return True
        else:
            return False

    def analizar(self, texto):
        vocales = 0
        consonantes = 0
        numeros = 0

        for letra in texto:

            if letra.isdigit():
                numeros = numeros + 1

            elif letra.isalpha():

                if self.es_vocal(letra):
                    vocales = vocales + 1
                else:
                    consonantes = consonantes + 1

        if len(texto) > len(self.texto_mayor):
            self.texto_mayor = texto

        return {
            "vocales": vocales,
            "consonantes": consonantes,
            "numeros": numeros
        }


a = AnalizadorCaracteres()

print(a.analizar("Python123"))