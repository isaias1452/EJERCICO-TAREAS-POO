class Equipos:

    def __init__(self):
        self.equipos = {}

    def crear_equipo(self, nombre_equipo):
        self.equipos[nombre_equipo] = []

    def agregar_jugador(self, equipo, jugador):
        if equipo in self.equipos:
            self.equipos[equipo].append(jugador)

    def equipo_mayor_integrantes(self):
        if len(self.equipos) == 0:
            return None

        mayor = None
        cantidad = 0

        for equipo, jugadores in self.equipos.items():
            if len(jugadores) > cantidad:
                cantidad = len(jugadores)
                mayor = equipo

        return mayor


# Programa principal

eq = Equipos()

eq.crear_equipo("A")
eq.crear_equipo("B")

eq.agregar_jugador("A", "Juan")
eq.agregar_jugador("A", "Pedro")

eq.agregar_jugador("B", "Carlos")
eq.agregar_jugador("B", "Luis")
eq.agregar_jugador("B", "Ana")

print(eq.equipos)
print("Equipo con más integrantes:", eq.equipo_mayor_integrantes())