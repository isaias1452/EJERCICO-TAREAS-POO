class DivisorFinder:

    def encontrar_divisores(self, numero):

        divisores = []

        for i in range(1, numero + 1):
            if numero % i == 0:
                divisores.append(i)

        return tuple(divisores)

    def es_perfecto(self, numero):

        suma = 0

        for divisor in self.encontrar_divisores(numero):
            if divisor != numero:
                suma += divisor

        return suma == numero

    def encontrar_multiples_divisores(self, *numeros):

        resultado = {}

        for numero in numeros:
            resultado[numero] = self.encontrar_divisores(numero)

        return resultado


# Programa principal

df = DivisorFinder()

print("Divisores de 12:", df.encontrar_divisores(12))
print("¿6 es perfecto?", df.es_perfecto(6))
print("Divisores:", df.encontrar_multiples_divisores(6, 10, 12))